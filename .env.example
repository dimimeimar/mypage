# Copy to .env.local (never commit real values)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# EmailJS (notification for new booking requests)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Ψηφιακή Γραμματεία: μόνο για το script scripts/build-kb.mjs (αρχείο .env.kb, ποτέ commit)
# GEMINI_API_KEY=
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Secrets του Edge Function ask: supabase secrets set GEMINI_API_KEY=... ASSISTANT_SALT=... (προαιρετικά LLM_MODEL, MIN_SIMILARITY, ASSISTANT_USER_LIMIT, ASSISTANT_GLOBAL_LIMIT)
